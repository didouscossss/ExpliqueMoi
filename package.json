{
  "name": "expliquemoi",
  "version": "2.3.4-restored",
  "private": true,
  "type": "module",
  "description": "ExpliqueMoi — analyse de documents français",
  "scripts": {
    "test:pdf": "node scripts/test-pdf-suite.mjs",
    "test:pdf:local": "node scripts/run-local-analyze.mjs",
    "test:assist": "node scripts/test-assist-actions.mjs",
    "test:pdf-pages": "node scripts/test-pdf-page-limit.mjs",
    "test:photo-compression": "node scripts/test-photo-compression.mjs",
    "test:analysis-quality": "node scripts/test-analysis-quality.mjs",
    "test:upload-payload": "node scripts/test-upload-payload.mjs",
    "test:v4-types": "tsx scripts/test-v4-types.mjs",
    "test:v4-candidates": "tsx scripts/test-v4-candidates.mjs",
    "test:v4-consistency": "tsx scripts/test-v4-consistency.mjs",
    "test:v4-classification": "tsx scripts/test-v4-classification.mjs",
    "test:v4-profiles": "tsx scripts/test-v4-profiles.mjs",
    "test:v4-understanding": "tsx scripts/test-v4-understanding.mjs",
    "test:v4-explanation": "tsx scripts/test-v4-explanation.mjs",
    "test:v4-presentation": "tsx scripts/test-v4-presentation.mjs",
    "test:v4-end-to-end": "tsx scripts/test-v4-end-to-end.mjs",
    "test:v4-robustness": "tsx scripts/test-v4-robustness.mjs",
    "test:v4-typecheck": "tsc -p tsconfig.v4.json --noEmit",
    "test:v4": "npm run test:v4-typecheck && npm run test:v4-types && npm run test:v4-candidates && npm run test:v4-consistency && npm run test:v4-classification && npm run test:v4-profiles && npm run test:v4-understanding && npm run test:v4-explanation && npm run test:v4-presentation && npm run test:v4-end-to-end && npm run test:v4-robustness"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
