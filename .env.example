# Gemini (chemin V3 / production)
GEMINI_API_KEY=

# V4-K — moteur documentaire local (Preview uniquement recommandé)
# false (défaut) = comportement V3 inchangé
# true = extraction existante → analyzeDocumentV4 → mapping Preview (0 LLM)
USE_V4_ENGINE=false

# Optionnel : autoriser ?engine=v4 sur Preview/dev (jamais en production)
ALLOW_V4_QUERY=false
